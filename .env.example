# Public (client-safe) env vars — only VITE_* are exposed to the browser.

# IremboPay payment page base URL (optional; defaults to https://pay.irembo.gov.rw)
# VITE_IREMBO_PAY_URL=https://pay.irembo.gov.rw

# Supabase (for Impact Stories and admin) — use anon key only in client
# When set, impact stories are loaded from DB; /admin allows CRUD after sign-in.
# Create the first admin user via Supabase Dashboard (Authentication > Users > Add user).
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Contact form: POST endpoint that accepts JSON { firstName, lastName, email, subject, message }
# e.g. Formspree: https://formspree.io/f/your-form-id
# VITE_CONTACT_FORM_ENDPOINT=

# Do NOT add GEMINI_API_KEY or other secrets here. Use server/Edge env only.
